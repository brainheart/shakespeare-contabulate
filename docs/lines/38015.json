[{"line_id": 1, "canonical_id": "TNK.3.3.1", "speaker": "ARCITE", "text": "I should be near the place.—Ho! Cousin Palamon!"}, {"line_id": 2, "canonical_id": "TNK.3.3.2", "speaker": "PALAMON", "text": "Arcite?"}, {"line_id": 3, "canonical_id": "TNK.3.3.3", "speaker": "ARCITE", "text": "The same. I have brought you food and files."}, {"line_id": 4, "canonical_id": "TNK.3.3.4", "speaker": "ARCITE", "text": "Come forth and fear not; here’s no Theseus."}, {"line_id": 5, "canonical_id": "TNK.3.3.5", "speaker": "PALAMON", "text": "Nor none so honest, Arcite."}, {"line_id": 6, "canonical_id": "TNK.3.3.6", "speaker": "ARCITE", "text": "That’s no matter."}, {"line_id": 7, "canonical_id": "TNK.3.3.7", "speaker": "ARCITE", "text": "We’ll argue that hereafter. Come, take courage;"}, {"line_id": 8, "canonical_id": "TNK.3.3.8", "speaker": "ARCITE", "text": "You shall not die thus beastly. Here, sir, drink—"}, {"line_id": 9, "canonical_id": "TNK.3.3.9", "speaker": "ARCITE", "text": "I know you are faint—then I’ll talk further with you."}, {"line_id": 10, "canonical_id": "TNK.3.3.10", "speaker": "PALAMON", "text": "Arcite, thou mightst now poison me."}, {"line_id": 11, "canonical_id": "TNK.3.3.11", "speaker": "ARCITE", "text": "I might;"}, {"line_id": 12, "canonical_id": "TNK.3.3.12", "speaker": "ARCITE", "text": "But I must fear you first. Sit down and, good now,"}, {"line_id": 13, "canonical_id": "TNK.3.3.13", "speaker": "ARCITE", "text": "No more of these vain parleys. Let us not,"}, {"line_id": 14, "canonical_id": "TNK.3.3.14", "speaker": "ARCITE", "text": "Having our ancient reputation with us,"}, {"line_id": 15, "canonical_id": "TNK.3.3.15", "speaker": "ARCITE", "text": "Make talk for fools and cowards. To your health."}, {"line_id": 16, "canonical_id": "TNK.3.3.16", "speaker": "PALAMON", "text": "Do!"}, {"line_id": 17, "canonical_id": "TNK.3.3.17", "speaker": "ARCITE", "text": "Pray sit down, then, and let me entreat you,"}, {"line_id": 18, "canonical_id": "TNK.3.3.18", "speaker": "ARCITE", "text": "By all the honesty and honor in you,"}, {"line_id": 19, "canonical_id": "TNK.3.3.19", "speaker": "ARCITE", "text": "No mention of this woman; ’twill disturb us."}, {"line_id": 20, "canonical_id": "TNK.3.3.20", "speaker": "ARCITE", "text": "We shall have time enough."}, {"line_id": 21, "canonical_id": "TNK.3.3.21", "speaker": "PALAMON", "text": "Well, sir, I’ll pledge you."}, {"line_id": 22, "canonical_id": "TNK.3.3.22", "speaker": "ARCITE", "text": "Drink a good hearty draught; it breeds good blood,"}, {"line_id": 23, "canonical_id": "TNK.3.3.23", "speaker": "ARCITE", "text": "man."}, {"line_id": 24, "canonical_id": "TNK.3.3.24", "speaker": "ARCITE", "text": "Do not you feel it thaw you?"}, {"line_id": 25, "canonical_id": "TNK.3.3.25", "speaker": "PALAMON", "text": "Stay, I’ll tell you"}, {"line_id": 26, "canonical_id": "TNK.3.3.26", "speaker": "PALAMON", "text": "After a draught or two more."}, {"line_id": 27, "canonical_id": "TNK.3.3.27", "speaker": "ARCITE", "text": "Spare it not."}, {"line_id": 28, "canonical_id": "TNK.3.3.28", "speaker": "ARCITE", "text": "The Duke has more, coz. Eat now."}, {"line_id": 29, "canonical_id": "TNK.3.3.29", "speaker": "PALAMON", "text": "Yes."}, {"line_id": 30, "canonical_id": "TNK.3.3.30", "speaker": "ARCITE", "text": "I am glad"}, {"line_id": 31, "canonical_id": "TNK.3.3.31", "speaker": "ARCITE", "text": "You have so good a stomach."}, {"line_id": 32, "canonical_id": "TNK.3.3.32", "speaker": "PALAMON", "text": "I am gladder"}, {"line_id": 33, "canonical_id": "TNK.3.3.33", "speaker": "PALAMON", "text": "I have so good meat to ’t."}, {"line_id": 34, "canonical_id": "TNK.3.3.34", "speaker": "ARCITE", "text": "Is ’t not mad lodging"}, {"line_id": 35, "canonical_id": "TNK.3.3.35", "speaker": "ARCITE", "text": "Here in the wild woods, cousin?"}, {"line_id": 36, "canonical_id": "TNK.3.3.36", "speaker": "PALAMON", "text": "Yes, for them"}, {"line_id": 37, "canonical_id": "TNK.3.3.37", "speaker": "PALAMON", "text": "That have wild consciences."}, {"line_id": 38, "canonical_id": "TNK.3.3.38", "speaker": "ARCITE", "text": "How tastes your"}, {"line_id": 39, "canonical_id": "TNK.3.3.39", "speaker": "ARCITE", "text": "victuals?"}, {"line_id": 40, "canonical_id": "TNK.3.3.40", "speaker": "ARCITE", "text": "Your hunger needs no sauce, I see."}, {"line_id": 41, "canonical_id": "TNK.3.3.41", "speaker": "PALAMON", "text": "Not much."}, {"line_id": 42, "canonical_id": "TNK.3.3.42", "speaker": "PALAMON", "text": "But if it did, yours is too tart, sweet cousin."}, {"line_id": 43, "canonical_id": "TNK.3.3.43", "speaker": "PALAMON", "text": "What is this?"}, {"line_id": 44, "canonical_id": "TNK.3.3.44", "speaker": "ARCITE", "text": "Venison."}, {"line_id": 45, "canonical_id": "TNK.3.3.45", "speaker": "PALAMON", "text": "’Tis a lusty meat."}, {"line_id": 46, "canonical_id": "TNK.3.3.46", "speaker": "PALAMON", "text": "Give me more wine. Here, Arcite, to the wenches"}, {"line_id": 47, "canonical_id": "TNK.3.3.47", "speaker": "PALAMON", "text": "We have known in our days!He raises his cup in a toast."}, {"line_id": 48, "canonical_id": "TNK.3.3.48", "speaker": "PALAMON", "text": "The Lord Steward’s"}, {"line_id": 49, "canonical_id": "TNK.3.3.49", "speaker": "PALAMON", "text": "daughter!"}, {"line_id": 50, "canonical_id": "TNK.3.3.50", "speaker": "PALAMON", "text": "Do you remember her?"}, {"line_id": 51, "canonical_id": "TNK.3.3.51", "speaker": "ARCITE", "text": "After you, coz."}, {"line_id": 52, "canonical_id": "TNK.3.3.52", "speaker": "PALAMON", "text": "She loved a black-haired man."}, {"line_id": 53, "canonical_id": "TNK.3.3.53", "speaker": "ARCITE", "text": "She did so; well, sir?"}, {"line_id": 54, "canonical_id": "TNK.3.3.54", "speaker": "PALAMON", "text": "And I have heard some call him Arcite, and—"}, {"line_id": 55, "canonical_id": "TNK.3.3.55", "speaker": "ARCITE", "text": "Out with ’t, faith."}, {"line_id": 56, "canonical_id": "TNK.3.3.56", "speaker": "PALAMON", "text": "She met him in an arbor."}, {"line_id": 57, "canonical_id": "TNK.3.3.57", "speaker": "PALAMON", "text": "What did she there, coz? Play o’ th’ virginals?"}, {"line_id": 58, "canonical_id": "TNK.3.3.58", "speaker": "ARCITE", "text": "Something she did, sir."}, {"line_id": 59, "canonical_id": "TNK.3.3.59", "speaker": "PALAMON", "text": "Made her groan a month"}, {"line_id": 60, "canonical_id": "TNK.3.3.60", "speaker": "PALAMON", "text": "for ’t—"}, {"line_id": 61, "canonical_id": "TNK.3.3.61", "speaker": "PALAMON", "text": "Or two, or three, or ten."}, {"line_id": 62, "canonical_id": "TNK.3.3.62", "speaker": "ARCITE", "text": "The Marshal’s sister"}, {"line_id": 63, "canonical_id": "TNK.3.3.63", "speaker": "ARCITE", "text": "Had her share, too, as I remember, cousin,"}, {"line_id": 64, "canonical_id": "TNK.3.3.64", "speaker": "ARCITE", "text": "Else there be tales abroad. You’ll pledge her?"}, {"line_id": 65, "canonical_id": "TNK.3.3.65", "speaker": "PALAMON", "text": "Yes."}, {"line_id": 66, "canonical_id": "TNK.3.3.66", "speaker": "ARCITE", "text": "A pretty brown wench ’tis. There was a time"}, {"line_id": 67, "canonical_id": "TNK.3.3.67", "speaker": "ARCITE", "text": "When young men went a-hunting, and a wood,"}, {"line_id": 68, "canonical_id": "TNK.3.3.68", "speaker": "ARCITE", "text": "And a broad beech—and thereby hangs a tale."}, {"line_id": 69, "canonical_id": "TNK.3.3.69", "speaker": "ARCITE", "text": "Heigh ho!"}, {"line_id": 70, "canonical_id": "TNK.3.3.70", "speaker": "PALAMON", "text": "For Emily, upon my life! Fool,"}, {"line_id": 71, "canonical_id": "TNK.3.3.71", "speaker": "PALAMON", "text": "Away with this strained mirth. I say again"}, {"line_id": 72, "canonical_id": "TNK.3.3.72", "speaker": "PALAMON", "text": "That sigh was breathed for Emily. Base cousin,"}, {"line_id": 73, "canonical_id": "TNK.3.3.73", "speaker": "PALAMON", "text": "Dar’st thou break first?"}, {"line_id": 74, "canonical_id": "TNK.3.3.74", "speaker": "ARCITE", "text": "You are wide."}, {"line_id": 75, "canonical_id": "TNK.3.3.75", "speaker": "PALAMON", "text": "By heaven and"}, {"line_id": 76, "canonical_id": "TNK.3.3.76", "speaker": "PALAMON", "text": "Earthearth,"}, {"line_id": 77, "canonical_id": "TNK.3.3.77", "speaker": "PALAMON", "text": "There’s nothing in thee honest."}, {"line_id": 78, "canonical_id": "TNK.3.3.78", "speaker": "ARCITE", "text": "Then I’ll leave you."}, {"line_id": 79, "canonical_id": "TNK.3.3.79", "speaker": "ARCITE", "text": "You are a beast now."}, {"line_id": 80, "canonical_id": "TNK.3.3.80", "speaker": "PALAMON", "text": "As thou mak’st me, traitor."}, {"line_id": 81, "canonical_id": "TNK.3.3.81", "speaker": "ARCITE", "text": "There’s all things needful: files and shirts and"}, {"line_id": 82, "canonical_id": "TNK.3.3.82", "speaker": "ARCITE", "text": "perfumes.ACT 3. SC. 4"}, {"line_id": 83, "canonical_id": "TNK.3.3.83", "speaker": "ARCITE", "text": "I’ll come again some two hours hence and bring"}, {"line_id": 84, "canonical_id": "TNK.3.3.84", "speaker": "ARCITE", "text": "That that shall quiet all."}, {"line_id": 85, "canonical_id": "TNK.3.3.85", "speaker": "PALAMON", "text": "A sword and armor."}, {"line_id": 86, "canonical_id": "TNK.3.3.86", "speaker": "ARCITE", "text": "Fear me not. You are now too foul. Farewell."}, {"line_id": 87, "canonical_id": "TNK.3.3.87", "speaker": "ARCITE", "text": "Get off your trinkets; you shall want naught."}, {"line_id": 88, "canonical_id": "TNK.3.3.88", "speaker": "PALAMON", "text": "Sirrah—"}, {"line_id": 89, "canonical_id": "TNK.3.3.89", "speaker": "ARCITE", "text": "I’ll hear no more."}, {"line_id": 90, "canonical_id": "TNK.3.3.90", "speaker": "PALAMON", "text": "If he keep touch, he dies for ’t."}]